<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>b-net – Designentwurf</title>

<style>

:root {
    /* b-net Farbschema */
    --bnet-blue: #0057FF;
    --bnet-blue-dark: #0047D6;
    --bnet-blue-light: #EEF4FF;

    --text-main: #1B1D21;
    --text-secondary: #555B65;

    --background: #FFFFFF;
    --background-soft: #F5F6F8;

    --border: #DDE2EA;
}

/* Grundlayout */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    color: var(--text-main);
    background: var(--background);
    line-height: 1.6;
}

.container {
    width: min(1120px, 90%);
    margin: 0 auto;
}


/* ----------------------------------------------------
   HEADER
---------------------------------------------------- */

header {
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
}

.header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* vorläufige typografische Logo-Darstellung */

.logo {
    display: flex;
    align-items: center;
    gap: 5px;

    font-size: 30px;
    font-weight: 600;
    letter-spacing: -1px;
}

.logo-b {
    color: var(--bnet-blue);
    font-style: italic;
    font-size: 36px;
    font-weight: 700;
}

.logo-net {
    color: var(--text-main);
    font-weight: 500;
}

nav a {
    margin-left: 28px;
    color: var(--text-main);
    text-decoration: none;
    font-size: 15px;
}

nav a:hover {
    color: var(--bnet-blue);
}


/* ----------------------------------------------------
   HERO
---------------------------------------------------- */

.hero {
    position: relative;
    padding: 110px 0 130px;
    overflow: hidden;
}

.hero h1 {
    max-width: 800px;

    margin: 0 0 28px;

    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.08;
    letter-spacing: -2px;
}

.hero h1 span {
    color: var(--bnet-blue);
}

.hero p {
    max-width: 760px;

    font-size: 21px;
    line-height: 1.65;

    color: var(--text-secondary);
}


/* moderne Interpretation der alten blauen Kurve */

.hero::after {
    content: "";

    position: absolute;

    left: -5%;
    bottom: -110px;

    width: 110%;
    height: 150px;

    background: var(--bnet-blue);

    border-radius:
        55% 45% 0 0 /
        100% 100% 0 0;
}


/* ----------------------------------------------------
   INTRO
---------------------------------------------------- */

.section {
    padding: 90px 0;
}

.section-soft {
    background: var(--background-soft);
}

.eyebrow {
    color: var(--bnet-blue);

    font-size: 14px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 1.3px;
}

.section-title {
    max-width: 760px;

    margin-top: 10px;

    font-size: 38px;
    line-height: 1.2;
    letter-spacing: -1px;
}

.section-intro {
    max-width: 760px;

    margin-bottom: 50px;

    color: var(--text-secondary);
    font-size: 18px;
}


/* ----------------------------------------------------
   KOMPETENZ-BOXEN
---------------------------------------------------- */

.competence {
    display: grid;

    grid-template-columns: 90px 1fr;

    margin-bottom: 34px;

    background: white;

    border: 1px solid var(--border);
    border-radius: 8px;

    overflow: hidden;
}

.competence-number {
    display: flex;
    justify-content: center;
    align-items: flex-start;

    padding-top: 32px;

    color: var(--bnet-blue);

    font-size: 22px;
    font-weight: 700;

    border-right: 1px solid var(--border);
}

.competence-content {
    padding: 32px 38px 38px;
}

.competence h3 {
    margin: 0 0 16px;

    font-size: 25px;
    line-height: 1.3;
}

.competence p {
    max-width: 850px;

    color: var(--text-secondary);
    font-size: 17px;
}


/* kleine blaue Betonung */

.blue-line {
    width: 52px;
    height: 4px;

    margin: 18px 0 22px;

    background: var(--bnet-blue);
}


/* ----------------------------------------------------
   WIRKUNGSBOX
---------------------------------------------------- */

.effect-box {
    margin-top: 25px;
    padding: 22px 26px;

    background: var(--background-soft);

    border-left: 4px solid var(--bnet-blue);
}

.effect-box strong {
    display: block;

    margin-bottom: 8px;

    color: var(--text-main);
}


/* ----------------------------------------------------
   PROJEKTPRAXIS
---------------------------------------------------- */

.project-example {
    margin-top: 24px;
    padding: 24px 28px;

    background: var(--bnet-blue-light);

    border-left: 4px solid var(--bnet-blue);

    border-radius: 0 5px 5px 0;
}

.project-example .label {
    margin-bottom: 6px;

    color: var(--bnet-blue-dark);

    font-size: 14px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: .8px;
}

.project-example p {
    margin: 0;

    color: var(--text-secondary);
}


/* ----------------------------------------------------
   FARBPALETTE
---------------------------------------------------- */

.colors {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(180px, 1fr));

    gap: 20px;

    margin-top: 40px;
}

.color-box {
    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 6px;

    background: white;
}

.color-preview {
    height: 100px;
}

.color-info {
    padding: 16px;
}

.color-info strong {
    display: block;
}

.color-info span {
    color: var(--text-secondary);
    font-size: 14px;
}


/* ----------------------------------------------------
   FOOTER
---------------------------------------------------- */

footer {
    padding: 45px 0;

    border-top: 4px solid var(--bnet-blue);

    color: var(--text-secondary);
    font-size: 14px;
}


/* ----------------------------------------------------
   MOBILE
---------------------------------------------------- */

@media (max-width: 700px) {

    nav {
        display: none;
    }

    .hero {
        padding: 75px 0 110px;
    }

    .competence {
        grid-template-columns: 1fr;
    }

    .competence-number {
        justify-content: flex-start;

        padding: 20px 25px 0;

        border-right: none;
    }

    .competence-content {
        padding: 15px 25px 30px;
    }

}

</style>
</head>


