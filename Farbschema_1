    <!-- 04 -->

    <div class="competence">

        <div class="competence-number">
            04
        </div>

        <div class="competence-content">

            <h3>
                Ursachen erkennen,
                Risiken präventiv steuern
            </h3>

            <div class="blue-line"></div>

            <p>
                Risiken bis zu ihren Ursachen zurückverfolgen
